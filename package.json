{
  "name": "persian-markdown-preview",
  "private": true,
  "version": "1.0.0",
  "description": "A privacy-friendly, in-browser Markdown viewer with first-class RTL/Persian support, extended syntax, and Mermaid diagrams.",
  "author": "Ali Houshyari Pour <alihoushyaripour@gmail.com>",
  "license": "MIT",
  "keywords": [
    "markdown",
    "persian",
    "farsi",
    "rtl",
    "preview",
    "mermaid",
    "vite",
    "react"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource/vazirmatn": "latest",
    "@tailwindcss/vite": "latest",
    "dompurify": "latest",
    "highlight.js": "latest",
    "lucide-react": "latest",
    "marked": "latest",
    "marked-alert": "^2.1.2",
    "marked-footnote": "^1.4.0",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-highlight": "latest",
    "mermaid": "^11.16.0",
    "react": "latest",
    "react-dom": "latest",
    "tailwindcss": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/dompurify": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "typescript": "latest",
    "typescript-eslint": "^8.60.0",
    "vite": "latest"
  }
}
